{
  "name": "@kalutskii/contract",
  "version": "2.0.2",
  "description": "TypeScript contract library for generating, versioning, and distributing type definitions across services.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalutskii/contract.git"
  },
  "bin": {
